{
  "dashboard": {
    "title": "Nexus Hospitality — Executive Operations Center",
    "uid": "nexus-executive-ops",
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Global Occupancy (Real-time)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "sum(nexus_occupancy_rate) / count(nexus_occupancy_rate)",
          "legendFormat": "Global Avg"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 0.8}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Today's Revenue",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "sum(nexus_revenue_total)",
          "legendFormat": "Revenue"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 3,
        "title": "Active IPTV Streams",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [{
          "expr": "sum(iptv_active_streams)",
          "legendFormat": "Streams"
        }]
      },
      {
        "id": 4,
        "title": "IoT Device Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [{
          "expr": "sum(iot_device_online) / sum(iot_device_total)",
          "legendFormat": "Online %"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.9},
                {"color": "green", "value": 0.99}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Occupancy by Region",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "nexus_occupancy_rate{region=~"us-.*"}",
            "legendFormat": "{{ region }}"
          },
          {
            "expr": "nexus_occupancy_rate{region=~"eu-.*"}",
            "legendFormat": "{{ region }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Revenue Breakdown",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [{
          "expr": "sum by (category) (nexus_revenue_total)",
          "legendFormat": "{{ category }}"
        }],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"}
        }
      },
      {
        "id": 7,
        "title": "AI Inference Load",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "rate(ai_inference_total[5m])",
            "legendFormat": "{{ model }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 8,
        "title": "Guest Sentiment (NLP)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [{
          "expr": "nexus_nps_score",
          "legendFormat": "NPS"
        }, {
          "expr": "nexus_sentiment_score",
          "legendFormat": "Sentiment"
        }],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 10
          }
        }
      },
      {
        "id": 9,
        "title": "Streaming Quality (QoE)",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
        "targets": [{
          "expr": "sum by (le) (rate(iptv_qoe_score_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{ le }}"
        }],
        "options": {
          "calculate": false,
          "yAxis": {"unit": "none", "min": 0, "max": 100}
        }
      },
      {
        "id": 10,
        "title": "Anomaly Detection Feed",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
        "targets": [{
          "expr": "anomaly_detections{severity=~"high|critical"}",
          "format": "table",
          "instant": true
        }],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "indexByName": {
                "timestamp": 0,
                "anomaly_type": 1,
                "entity_id": 2,
                "severity": 3,
                "deviation_score": 4
              }
            }
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "tenant",
          "type": "query",
          "query": "label_values(nexus_tenant_info, tenant_id)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        },
        {
          "name": "property",
          "type": "query",
          "query": "label_values(nexus_property_info{tenant_id=~"$tenant"}, property_id)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        },
        {
          "name": "region",
          "type": "query",
          "query": "label_values(nexus_region_info, region)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        }
      ]
    }
  }
}