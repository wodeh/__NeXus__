-     proc.cmdline contains "-fr" or
-     proc.cmdline contains "/*") and
-    not (proc.user.name in (cleanup_service, log_rotator) or
-         proc.cmdline contains "/tmp/" or
-         proc.cmdline contains "/var/log/")
-  output: >
-    Mass file deletion detected
-    user=%proc.user.name command=%proc.cmdline
-    container=%container.name pod=%k8s.pod.name
-  priority: HIGH
-  tags: [destruction, ransomware, data_loss]
-
-- rule: Tenant Isolation Breach
-  desc: Detect cross-tenant data access
-  condition: >
-    spawned_process and
-    (proc.cmdline contains "tenant_id" or
-     proc.cmdline contains "tenantId") and
-    (proc.cmdline contains "SELECT" or
-     proc.cmdline contains "UPDATE" or
-     proc.cmdline contains "DELETE") and
-    proc.cmdline contains "WHERE" and
-    not proc.cmdline contains "tenant_id = "
-  output: >
-    Potential tenant isolation breach - query missing tenant filter
-    user=%proc.user.name command=%proc.cmdline
-    container=%container.name pod=%k8s.pod.name
-  priority: CRITICAL
-  tags: [tenant_isolation, saas_security, data_breach]
-
-- list: malicious_ip_list
-  items: [
-    "192.0.2.1", "198.51.100.1", "203.0.113.1",
-    "10.0.0.99", "172.16.0.99"
-  ]
-
-- list: authorized_db_users
-  items: [postgres, app_user, backup_service, analytics_etl, compliance_audit]
-
-- list: authorized_iot_users
-  items: [iot_service, ota_manager, device_manager]
-
-- macro: spawned_process
-  condition: (evt.type = execve and evt.dir=<)
-
-- macro: open_read
-  condition: (evt.type in (open, openat) and evt.dir=< and fd.type=file)
-
-- macro: outbound
-  condition: (evt.type in (connect) and evt.dir=< and fd.type=ipv4)
