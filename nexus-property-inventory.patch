-		}
-
-		name, ret := dev.GetName()
-		if ret != nvml.SUCCESS {
-			log.Printf("Failed to get name for device %d: %v", i, nvml.ErrorString(ret))
-		}
-
-		memInfo, ret := dev.GetMemoryInfo()
