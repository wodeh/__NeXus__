-      timeUnit: '1m',
-      duration: '30m',
-      preAllocatedVUs: 500,
-      maxVUs: 2000,
-      exec: 'iptvStreaming',
-    },
-
-    // IoT telemetry ingestion
-    iot_telemetry: {
-      executor: 'constant-vus',
-      vus: 5000,
-      duration: '30m',
