-        { duration: '10m', target: 1000 },  // Steady state
-        { duration: '5m', target: 2000 },   // Spike
-        { duration: '10m', target: 2000 },  // Sustained spike
-        { duration: '5m', target: 0 },      // Ramp down
-      ],
-      gracefulRampDown: '30s',
-      exec: 'guestPortal',
-    },
-
-    // IPTV streaming load
-    iptv_streaming: {
-      executor: 'constant-arrival-rate',
