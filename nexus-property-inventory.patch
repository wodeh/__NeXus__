-      templateType: NetworkChaos
-      networkChaos:
-        action: partition
-        mode: all
-        selector:
-          namespaces:
-            - nexus-prod
-          labelSelectors:
-            app.kubernetes.io/component: streaming-edge
-        direction: both
-        target:
-          mode: all
-          selector:
-            namespaces:
