-# observability/monitoring/prometheus-rules/nexus-alerts.yaml
-# ============================================================
-# PROMETHEUS ALERTING RULES — Enterprise hospitality platform
-# ============================================================
-
-groups:
-  # ==================== PLATFORM HEALTH ====================
-  - name: platform-health
-    interval: 15s
-    rules:
-      - alert: NexusPlatformDown
-        expr: up{job=~"nexus-.*"} == 0
-        for: 1m
-        labels:
-          severity: critical
-          team: sre
-          service: "{{ $labels.job }}"
-        annotations:
-          summary: "Nexus service {{ $labels.job }} is down"
-          description: "Service {{ $labels.job }} on {{ $labels.instance }} has been down for more than 1 minute"
-          runbook_url: "https://wiki.nexus-platform.com/runbooks/service-down"
-
-      - alert: HighErrorRate
-        expr: |
-          sum(rate(http_requests_total{job=~"nexus-.*",status=~"5.."}[5m])) 
-          / 
-          sum(rate(http_requests_total{job=~"nexus-.*"}[5m])) > 0.05
-        for: 2m
-        labels:
-          severity: critical
-          team: sre
-        annotations:
-          summary: "High error rate on {{ $labels.job }}"
-          description: "Error rate is {{ $value | humanizePercentage }} over the last 5 minutes"
-
-      - alert: HighLatency
-        expr: |
-          histogram_quantile(0.99, 
-            sum(rate(http_request_duration_seconds_bucket{job=~"nexus-.*"}[5m])) by (le, job)
-          ) > 1
-        for: 3m
-        labels:
-          severity: warning
-          team: backend
-        annotations:
-          summary: "High latency on {{ $labels.job }}"
-          description: "P99 latency is {{ $value }}s"
-
-      - alert: DatabaseConnectionPoolExhausted
-        expr: |
-          nexus_db_connections_active / nexus_db_connections_max > 0.9
-        for: 1m
-        labels:
-          severity: critical
-          team: dba
-        annotations:
-          summary: "Database connection pool nearly exhausted"
-          description: "{{ $value | humanizePercentage }} of connections in use"
-
-  # ==================== IPTV STREAMING ====================
-  - name: iptv-health
-    interval: 15s
-    rules:
-      - alert: IPTVStreamDown
-        expr: iptv_active_streams == 0
-        for: 30s
-        labels:
-          severity: critical
-          team: iptv
-        annotations:
-          summary: "No active IPTV streams"
-          description: "All IPTV streams are down on {{ $labels.instance }}"
-
-      - alert: HighBufferingRate
-        expr: |
-          rate(iptv_buffering_events_total[5m]) > 0.1
-        for: 2m
-        labels:
-          severity: warning
-          team: iptv
-        annotations:
-          summary: "High buffering rate detected"
-          description: "{{ $value }} buffering events per second"
-
-      - alert: LowQoEScore
-        expr: iptv_qoe_score < 70
-        for: 5m
-        labels:
-          severity: warning
-          team: iptv
-        annotations:
-          summary: "Low QoE score for room {{ $labels.room_id }}"
-          description: "QoE score is {{ $value }}/100"
-
-      - alert: DRMKeyServerDown
-        expr: up{job="drm-key-server"} == 0
-        for: 30s
-        labels:
-          severity: critical
-          team: security
-        annotations:
-          summary: "DRM key server is down"
-          description: "Content protection may be compromised"
-
-      - alert: TranscodeQueueBacklog
-        expr: |
-          transcode_queue_depth > 50
-        for: 5m
-        labels:
-          severity: warning
-          team: media
-        annotations:
-          summary: "Transcode queue backlog"
-          description: "{{ $value }} jobs pending in queue"
-
-  # ==================== IoT & SMART ROOM ====================
-  - name: iot-health
-    interval: 15s
-    rules:
-      - alert: IoTDeviceOffline
-        expr: |
-          iot_device_last_seen > 300
-        for: 1m
-        labels:
-          severity: warning
-          team: iot
-        annotations:
-          summary: "IoT device {{ $labels.device_id }} is offline"
-          description: "No telemetry received for 5 minutes"
