-  namespace: chaos-testing
-spec:
-  entry: iptv-chaos-sequence
-  templates:
-    - name: iptv-chaos-sequence
-      templateType: Serial
-      deadline: 30m
-      children:
-        - name: inject-packet-loss
-        - name: inject-latency-spike
-        - name: kill-transcode-pods
-        - name: partition-nginx-nodes
-        - name: fill-disk-cache
-        - name: stress-gpu-memory
-
-    # Packet loss simulation (network degradation)
-    - name: inject-packet-loss
-      templateType: NetworkChaos
-      networkChaos:
-        action: loss
-        mode: all
-        selector:
-          namespaces:
-            - nexus-prod
-          labelSelectors:
-            app.kubernetes.io/component: iptv-transcode
-        loss:
-          loss: "10"
-          correlation: "100"
-        duration: 5m
-
-    # Latency spike (buffering simulation)
-    - name: inject-latency-spike
-      templateType: NetworkChaos
-      networkChaos:
-        action: delay
-        mode: all
-        selector:
-          namespaces:
-            - nexus-prod
-          labelSelectors:
-            app.kubernetes.io/component: streaming-edge
-        delay:
-          latency: 500ms
-          correlation: "50"
-          jitter: 200ms
-        duration: 5m
-
-    # Kill transcoding pods (resilience test)
-    - name: kill-transcode-pods
-      templateType: PodChaos
-      podChaos:
-        action: pod-kill
-        mode: fixed-percent
-        value: "30"
-        selector:
-          namespaces:
-            - nexus-prod
-          labelSelectors:
-            app.kubernetes.io/component: iptv-transcode
-        duration: 3m
-
-    # Network partition between streaming tiers
