-# Falco runtime security rules for NHC platform
-# Detects anomalous behavior in containers and hosts
-
-- rule: Unauthorized IPTV Stream Access
-  desc: Detect unauthorized attempts to access IPTV streams
-  condition: >
-    spawned_process and
-    container.name contains "iptv" and
-    (proc.name in (curl, wget, python, python3) and
-     (proc.args contains "/stream" or proc.args contains "/vod"))
-  output: >
-    Unauthorized stream access attempt
-    user=%user.name command=%proc.cmdline
-    container=%container.name
-  priority: WARNING
-
-- rule: DRM Key Extraction Attempt
-  desc: Detect attempts to extract DRM keys from containers
-  condition: >
-    spawned_process and
-    container.name contains "drm" and
-    (proc.name in (strings, grep, cat, dd) and
-     (proc.args contains "key" or proc.args contains "license"))
-  output: >
-    Potential DRM key extraction attempt
-    user=%user.name command=%proc.cmdline
-    container=%container.name
-  priority: CRITICAL
-
-- rule: Database Credential Access from Unexpected Container
-  desc: Detect database credential access from non-database containers
-  condition: >
-    open_read and
-    fd.name contains "/secrets/" and
-    fd.name contains "database" and
-    not (container.name contains "db" or container.name contains "sql")
-  output: >
-    Database credential access from unexpected container
-    user=%user.name file=%fd.name
-    container=%container.name
-  priority: HIGH
-
-- rule: Outbound Connection to Suspicious IP
-  desc: Detect outbound connections to known suspicious IPs
-  condition: >
-    outbound and
-    not (fd.sip in (trusted_cidrs)) and
-    container.name != "" and
-    k8s.ns.name in (nexus-iptv, nexus-global, nexus-data)
-  output: >
-    Outbound connection to suspicious IP
-    connection=%fd.name
-    container=%container.name
-    k8s.ns=%k8s.ns.name
-  priority: WARNING
-
-- rule: Privilege Escalation via Sudo
-  desc: Detect sudo usage in containers
-  condition: >
-    spawned_process and
-    proc.name = "sudo" and
-    container.name != ""
-  output: >
-    Privilege escalation attempt via sudo
-    user=%user.name command=%proc.cmdline
-    container=%container.name
-  priority: HIGH
-
-- rule: Cryptomining Detection
-  desc: Detect cryptomining activity
-  condition: >
-    spawned_process and
-    (proc.name in (xmrig, minerd, stratum) or
-     (proc.cmdline contains "stratum+tcp" or proc.cmdline contains "stratum+ssl"))
-  output: >
-    Potential cryptomining activity detected
-    user=%user.name command=%proc.cmdline
-    container=%container.name
-  priority: CRITICAL
-
-- rule: Sensitive File Access
-  desc: Detect access to sensitive files
-  condition: >
-    open_read and
-    (fd.name contains "/etc/shadow" or
-     fd.name contains "/etc/passwd" or
-     fd.name contains ".ssh/id_rsa" or
-     fd.name contains ".aws/credentials")
-  output: >
-    Sensitive file access detected
-    user=%user.name file=%fd.name
-    container=%container.name
-  priority: HIGH
-
-- rule: Kubernetes API Unauthorized Access
-  desc: Detect unauthorized Kubernetes API access
-  condition: >
-    spawned_process and
-    proc.name in (kubectl, helm) and
-    not (user.name in (admin, sre, cicd))
-  output: >
-    Unauthorized Kubernetes API access
-    user=%user.name command=%proc.cmdline
-  priority: HIGH
-
-- rule: Large Data Exfiltration
-  desc: Detect large outbound data transfers
-  condition: >
-    outbound and
-    evt.rawres >= 10485760 and  # 10MB
-    container.name != ""
