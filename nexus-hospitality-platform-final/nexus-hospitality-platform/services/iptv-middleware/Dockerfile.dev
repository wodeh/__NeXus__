# iptv-middleware — Development Dockerfile for transcode engine
FROM golang:1.22-alpine

RUN apk add --no-cache git ca-certificates tzdata ffmpeg

RUN go install github.com/cosmtrek/air@v1.49.0

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8081 9090

CMD ["air", "-c", ".air.toml"]
