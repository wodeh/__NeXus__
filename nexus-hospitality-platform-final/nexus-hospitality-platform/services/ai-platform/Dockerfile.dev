# ai-platform — Development Dockerfile for inference gateway
FROM golang:1.22-alpine

RUN apk add --no-cache git ca-certificates tzdata

RUN go install github.com/cosmtrek/air@v1.49.0

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080 9090

CMD ["air", "-c", ".air.toml"]
